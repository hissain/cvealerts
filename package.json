{
  "name": "cvealert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "digest": "node scripts/digest.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute cvealert --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute cvealert --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
