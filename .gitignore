# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Secrets and local env (never commit)
.env
.env.*
!.env.example
*.pem
*.key

# Generated CVE data: published to the orphan `data` branch by the ingest workflow, not committed to main
site/data/*
!site/data/.gitkeep

# Logs, caches, build output
*.log
.cache/
dist/
coverage/

# OS / editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
